{
  "id": "general_midi",
  "description": "Portable fallback; no library-specific keyswitches are invented.",
  "supports": {"keyswitch": false, "cc": [1, 7, 10, 11, 64], "pitch_bend": true, "mpe": false},
  "pitch_bend_range": 2,
  "performance_capabilities": {
    "automatic_fingering": false,
    "string_selection": false,
    "hand_position_control": false,
    "native_legato_samples": false,
    "native_strum_engine": false,
    "polyphonic_independent_bend": false,
    "semantic_fallbacks": [
      "note_overlap",
      "gate_shaping",
      "velocity_shaping",
      "explicit_strum_onset_spread",
      "partial_chord_voicing",
      "pitch_bend"
    ]
  },
  "articulations": {
    "palm_mute": {"fallback": {"gate_ratio": 0.58, "velocity_delta": -4}},
    "staccato": {"fallback": {"gate_ratio": 0.45, "velocity_delta": 0}},
    "accent": {"fallback": {"gate_ratio": 1.0, "velocity_delta": 6}},
    "legato": {"fallback": {"gate_ratio": 1.0, "velocity_delta": -1}},
    "sustain": {"fallback": {"gate_ratio": 1.0, "velocity_delta": 0}},
    "tenuto": {"fallback": {"gate_ratio": 0.95, "velocity_delta": 0}},
    "crescendo": {"fallback": {"gate_ratio": 1.0, "velocity_delta": 3}},
    "finger": {"fallback": {"gate_ratio": 0.92, "velocity_delta": 0}},
    "pick": {"fallback": {"gate_ratio": 0.82, "velocity_delta": 3}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "music-agent://skills-v2/acoustic-strumming/model.schema.json",
  "title": "Acoustic Guitar Continuous Eighth Strumming Model",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "technique",
    "subdivision",
    "slots_per_bar",
    "motion",
    "slot_profiles",
    "attack_mask",
    "evidence",
    "invariance_fingerprint",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "music-agent-acoustic-strumming-model"
    },
    "schema_version": {
      "const": 1
    },
    "technique": {
      "enum": [
        "continuous_eighth_alternating_strumming",
        "continuous_eighth_chord_attacks_direction_unobserved"
      ]
    },
    "subdivision": {
      "const": "eighth"
    },
    "slots_per_bar": {
      "type": "integer",
      "minimum": 1
    },
    "motion": {
      "type": "object",
      "required": [
        "type",
        "slot_zero_direction",
        "continuous_motion",
        "cross_bar_continuity",
        "alternate_direction_confidence"
      ],
      "properties": {
        "type": {
          "enum": ["alternate", "unknown"]
        },
        "slot_zero_direction": {
          "enum": ["down", "up", "unknown"]
        },
        "continuous_motion": {
          "type": "boolean"
        },
        "cross_bar_continuity": {
          "type": "boolean"
        },
        "alternate_direction_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "direction_observability": {
          "enum": [
            "observable",
            "weak_partial_evidence",
            "unobservable_quantized_onsets",
            "no_chordal_strokes"
          ]
        }
      },
      "additionalProperties": true
    },
    "slot_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slot",
          "expected_direction",
          "attack_probability",
          "dominant_stroke_type",
          "accent_class"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 0
          },
          "expected_direction": {
            "enum": ["down", "up", "unknown"]
          },
          "attack_probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "dominant_stroke_type": {
            "enum": [
              "full",
              "low_partial",
              "middle_partial",
              "high_partial",
              "double_stop",
              "single_string",
              "compact_chord",
              "air_candidate"
            ]
          },
          "accent_class": {
            "enum": ["light", "neutral", "accent"]
          }
        },
        "additionalProperties": true
      }
    },
    "attack_mask": {
      "type": "array",
      "items": {
        "enum": [0, 1]
      }
    },
    "evidence": {
      "type": "object"
    },
    "invariance_fingerprint": {
      "type": "object",
      "required": [
        "subdivision",
        "slot_zero_direction",
        "attack_mask",
        "dominant_stroke_types",
        "accent_classes"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
